# Made on each machine by SETUP.bat and Orthros -- not part of the project.

# The two live agents. Each keeps its own git history (the undo button for
# the other agent's edits), so they cannot live inside this repository.
# Their code is published through agent\, refreshed by `orthros.py --export`.
OrthrosCode A/
OrthrosCode B/
JanusCoder A/
JanusCoder B/

# ~800 MB of packages, rebuilt from agent/requirements.txt.
shared-venv/
venv/

# Orthros's runtime state, settings and logs.
logs/
.orthros-state.json
orthros.json
orthros.log
.janus-state.json
janus.json
janus.log

__pycache__/
*.pyc
*.tmp

# Written when Orthros gives up and needs a person; removed on Start.
ORTHROS-NEEDS-YOU.txt

# Projects the agents work on in task mode, and practice copies of exercises.
# Each is its own git repository.
tasks/
practice/

# What Orthros found out about this machine, and the settings that work on it.
hardware.json
.orthros-reprobe
